# Copy to .env.local for local development: cp .env.example .env.local

# Gate for the demo admin dashboard (/admin?key=...). Change before any deploy.
ADMIN_KEY=gameon-demo

# Where the browser should send API calls.
# Leave empty for the website (same-origin /api/*).
# Set to the deployed origin (e.g. https://gameon.vercel.app) when building the
# static export that Capacitor wraps into the Android APK — a static export has
# no API routes of its own.
NEXT_PUBLIC_API_BASE=

# Public site origin, used for metadata and absolute OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase PostgreSQL: required on Vercel. Server-only; never prefix NEXT_PUBLIC_.
# Use the transaction pooler URL (port 6543), URL-encode the database password,
# and enable TLS. Keep this value only in .env.local / Vercel environment settings.
DATABASE_URL=

# Optional PEM trust anchor for a custom/rotated database CA (literal \n accepted).
# Known Supabase database hosts use the bundled public Supabase root CA by default.
DATABASE_SSL_CA=

# Local SQLite demo fallback, used only when DATABASE_URL is empty outside Vercel.
DATABASE_PATH=./data/gameon.db
